{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "superidol-online",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-08",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://kun-cmd.github.io,http://127.0.0.1:4173,http://localhost:4173"
  }
}
